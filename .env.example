# URL of the running backend. Used by both dev Docker compose and the nginx prod image.
BACKEND_URL=http://localhost:8090
# Also used by `npm run test:backend` (src/lib/api.backend.test.ts) to log in
# for real against BACKEND_URL. Without these two, only the invalid-login
# case runs; the rest skip themselves with a console warning.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=