# URL of the running backend. Used by both dev Docker compose and the nginx prod image.
BACKEND_URL=http://localhost:8090
# URL de la página de monitoreo que expone infra (se embebe en un iframe; solo accesible
# desde la red de la facultad). Producción: MONITOREO_URL en el .env del servidor + reiniciar
# el contenedor. Desarrollo: VITE_MONITOREO_URL en .env.local. Si el Dashboard pasa a https,
# esta URL también tiene que ser https o el navegador bloquea el iframe.
MONITOREO_URL=
VITE_MONITOREO_URL=
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=